# Las variables de las pruebas de punta a punta (`npm run test:e2e`).
#
# Este archivo SÍ se commitea, y es a propósito: no tiene un solo secreto.
# Todo apunta a una base local que se levanta y se tira, y el AUTH_SECRET de
# acá no firma ninguna sesión de verdad.
#
# Lo que no puede pasar nunca es que una prueba que ESCRIBE —registra
# mascotas, emite certificados— corra contra la base de producción. Por eso
# `playwright.config.ts` se niega a arrancar si DATABASE_URL no es local.
#
# La base se levanta con Docker, una sola vez:
#   docker run -d --name libreta-e2e -e POSTGRES_PASSWORD=postgres \
#     -e POSTGRES_DB=libreta -p 54329:5432 postgres:16-alpine
DATABASE_URL="postgresql://postgres:postgres@localhost:54329/libreta"
DIRECT_URL="postgresql://postgres:postgres@localhost:54329/libreta"

AUTH_SECRET="secreto-de-las-pruebas-e2e-no-sirve-para-nada-mas"
# `next start` fuera de Vercel no confía en el host si no se lo dice.
AUTH_TRUST_HOST="true"
# Google no se usa: las pruebas fabrican la cookie de sesión (e2e/preparar.ts).
AUTH_GOOGLE_ID="e2e"
AUTH_GOOGLE_SECRET="e2e"

# Un storage que no responde, a propósito: las pruebas no suben archivos a
# ningún lado, y de paso ejercitan el camino del PDF "en preparación".
STORAGE_URL="http://127.0.0.1:9"
STORAGE_KEY="e2e"

# Que el aviso de versión nueva de Prisma no ensucie la salida de las pruebas.
PRISMA_HIDE_UPDATE_MESSAGE="1"
